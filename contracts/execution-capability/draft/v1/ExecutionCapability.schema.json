{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/execution-capability/draft/v1/ExecutionCapability.schema.json",
  "title": "ExecutionCapability",
  "description": "Draft BC04-to-acquisition-gateway capability for one admitted attempt.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "execution-capability/v1"},
    "issuer": {"const": "urn:data-mozaic:bc04:execution-coordination"},
    "recipient": {"const": "urn:data-mozaic:acquisition-gateway"},
    "algorithm": {"const": "Ed25519"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "audience": {"type": "string", "minLength": 1, "maxLength": 256},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 1},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "build_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "build_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_profile_id": {"const": "scrapy-live-http-v1"},
    "input_parameters_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expected_initial_target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_deadline": {"type": "string", "format": "date-time"},
    "capability_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{80,100}$"}
  },
  "required": ["contract_version", "issuer", "recipient", "algorithm", "key_id", "audience", "tenant_id", "run_id", "attempt_id", "generation", "source_id", "source_revision_id", "policy_id", "policy_version", "policy_digest", "release_id", "build_id", "build_manifest_digest", "runtime_profile_id", "issued_at", "expires_at", "execution_deadline", "capability_id", "signature"]
}
