{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/source-revision/draft/v1/SourceRevision.schema.json",
  "title": "SourceRevision",
  "description": "Draft BC01 immutable source revision. Documentation and examples are not authorization.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "source-revision/v1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "revision_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 256},
    "status": {"enum": ["eligible", "revoked"]},
    "scope": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GET"]}},
        "path_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/", "maxLength": 512}},
        "query_parameter_values": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[A-Za-z_$][A-Za-z0-9_$-]{0,63}$"}, "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}}}
      }, "required": ["origins", "methods", "path_prefixes", "query_parameter_values"]
    },
    "configuration_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "configuration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "metadata": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 512}}
  },
  "required": ["contract_version", "source_id", "revision_id", "owner", "status", "scope", "configuration_version", "configuration_digest"]
}
