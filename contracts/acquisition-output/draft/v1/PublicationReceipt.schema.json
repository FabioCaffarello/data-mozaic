{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.invalid/contracts/acquisition-output/draft/v1/PublicationReceipt.schema.json",
  "title": "PublicationReceipt draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tenant_id", "operation_id", "output_set_id", "manifest_digest", "publication_id", "published_at"],
  "properties": {
    "contract_version": {"const": "publication-receipt/v1"},
    "tenant_id": {"$ref": "CaptureOutput.schema.json#/$defs/identifier"},
    "operation_id": {"$ref": "CaptureOutput.schema.json#/$defs/identifier"},
    "output_set_id": {"$ref": "CaptureOutput.schema.json#/$defs/identifier"},
    "manifest_digest": {"$ref": "CaptureOutput.schema.json#/$defs/digest"},
    "publication_id": {"$ref": "CaptureOutput.schema.json#/$defs/identifier"},
    "published_at": {"type": "string", "format": "date-time"}
  }
}
