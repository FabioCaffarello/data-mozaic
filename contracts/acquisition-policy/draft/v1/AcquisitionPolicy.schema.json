{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/acquisition-policy/draft/v1/AcquisitionPolicy.schema.json",
  "title": "AcquisitionPolicy",
  "description": "Draft BC11 source-revision-bound policy. A playbook cannot authorize itself.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "acquisition-policy/v1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "policy_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "source_revision_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "status": {"enum": ["eligible", "revoked"]},
    "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GET"]}},
    "path_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/", "maxLength": 512}},
    "query_parameter_values": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[A-Za-z_$][A-Za-z0-9_$-]{0,63}$"}, "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 256}}},
    "dns_policy": {"enum": ["public-addresses-only", "test-fixture-only"]},
    "test_destination_cidrs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9a-fA-F:]+/128$"}},
    "redirect_policy": {"enum": ["deny", "revalidate-every-hop"]},
    "max_requests": {"type": "integer", "minimum": 1, "maximum": 50},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 4},
    "requests_per_second": {"type": "integer", "minimum": 1, "maximum": 10},
    "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "max_total_response_bytes": {"type": "integer", "minimum": 1, "maximum": 20000000},
    "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "require_tls": {"type": "boolean"},
    "credential_refs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
    "evidence_retention_policy_ref": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "required": ["contract_version", "policy_id", "policy_version", "source_id", "source_revision_id", "status", "origins", "methods", "path_prefixes", "query_parameter_values", "dns_policy", "redirect_policy", "max_requests", "max_concurrency", "requests_per_second", "max_response_bytes", "max_total_response_bytes", "deadline_seconds", "require_tls", "credential_refs", "evidence_retention_policy_ref", "policy_digest"],
  "allOf": [
    {"if": {"properties": {"dns_policy": {"const": "test-fixture-only"}}, "required": ["dns_policy"]}, "then": {"properties": {"require_tls": {"const": false}, "origins": {"items": {"pattern": "^(?:http://(?:127\\.0\\.0\\.1|localhost|controlled-source)|https://api\\.fixture\\.test)(:[0-9]+)?$"}}}}},
    {"if": {"properties": {"dns_policy": {"const": "public-addresses-only"}}, "required": ["dns_policy"]}, "then": {"properties": {"require_tls": {"const": true}, "origins": {"items": {"pattern": "^https://"}}, "test_destination_cidrs": {"maxItems": 0}}}}
  ]
}
