{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/fetch-evidence/draft/v1/FetchEvidence.schema.json",
  "title": "FetchEvidenceDraftV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "fetch-evidence/v1"},
    "fetch_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "tenant_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_revision_id": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release_id": {"type": "string", "minLength": 1},
    "build_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "effective_target_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_origin": {"type": "string", "format": "uri"},
    "effective_origin": {"type": "string", "format": "uri"},
    "request_path_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "effective_path_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "query_parameter_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "redirect_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "status": {"type": "integer", "minimum": 100, "maximum": 599},
    "acquired_at": {"type": "string", "format": "date-time"},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
    "body_representation": {"const": "decoded-http-entity"},
    "body_size": {"type": "integer", "minimum": 0},
    "body_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "body_ref": {"type": "string", "minLength": 1, "maxLength": 256}
  },
  "required": ["contract_version", "fetch_id", "tenant_id", "run_id", "attempt_id", "generation", "source_id", "source_revision_id", "policy_digest", "release_id", "build_manifest_digest", "request_target_digest", "effective_target_digest", "request_origin", "effective_origin", "request_path_digest", "effective_path_digest", "query_parameter_names", "redirect_count", "status", "acquired_at", "media_type", "body_representation", "body_size", "body_digest", "body_ref"]
}
