{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/scout/transcript/draft/v4/ScoutSessionTranscript.schema.json",
  "title": "ScoutSessionTranscriptDraftV4",
  "description": "Versioned BC14 to BC15 transcript carrying a versioned declarative PlaybookProposal where present.",
  "type": "object",
  "properties": {
    "transcript_schema": {
      "const": "scout-transcript-draft/v4"
    },
    "producer": {
      "type": "object",
      "properties": {
        "bounded_context": {
          "const": "BC14"
        },
        "tool_host": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bounded_context",
        "tool_host"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "exploring",
            "completed"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "session_id",
        "version",
        "state",
        "source",
        "objective"
      ],
      "additionalProperties": false
    },
    "approval_record": {
      "$ref": "#/$defs/approval"
    },
    "approved_scope": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        }
      },
      "required": [
        "source_id",
        "revision",
        "origin",
        "path_prefixes",
        "budgets"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "http_response",
              "rendered_dom",
              "trace",
              "other"
            ]
          },
          "redaction": {
            "enum": [
              "none",
              "redacted"
            ]
          },
          "manifest_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "size_bytes",
          "kind",
          "redaction",
          "manifest_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "proposal": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "classification": {
            "enum": [
              "observed",
              "hypothesized"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "finding_id",
          "classification",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "content_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "discovered_links": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "uniqueItems": true
          },
          "requested_url": {
            "type": "string",
            "format": "uri"
          },
          "observation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "discovered_from_observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "request_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "url",
          "content_type",
          "evidence_ref",
          "artifact_id",
          "sha256",
          "size_bytes",
          "discovered_links",
          "requested_url",
          "observation_id",
          "sequence",
          "discovered_from_observation_ids",
          "request_count"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "redaction": {
      "type": "object",
      "properties": {
        "raw_content_included": {
          "const": false
        },
        "policy": {
          "const": "metadata-only/v1"
        }
      },
      "required": [
        "raw_content_included",
        "policy"
      ],
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "custody_verified": {
          "const": true
        },
        "approval_authentication": {
          "const": "local-reference-not-cryptographically-signed"
        }
      },
      "required": [
        "custody_verified",
        "approval_authentication"
      ],
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "properties": {
        "start_requested_url": {
          "type": "string",
          "format": "uri"
        },
        "start_effective_url": {
          "type": "string",
          "format": "uri"
        },
        "sequence_complete": {
          "type": "boolean"
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "start_requested_url",
        "start_effective_url",
        "sequence_complete",
        "observation_count"
      ],
      "additionalProperties": false
    },
    "proposal_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "proposal": {
            "type": "object",
            "description": "Public BC14 PlaybookProposal contract v1 or v2."
          }
        },
        "required": [
          "revision",
          "proposal"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "transcript_schema",
    "producer",
    "session",
    "approval_record",
    "approved_scope",
    "objective",
    "evidence",
    "proposal",
    "findings",
    "pages",
    "redaction",
    "integrity",
    "navigation",
    "proposal_history"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "source_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        }
      },
      "required": [
        "max_requests",
        "max_pages",
        "max_response_bytes"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "budgets": {
          "$ref": "#/$defs/budgets"
        }
      },
      "required": [
        "approval_id",
        "source_id",
        "revision",
        "origin",
        "path_prefixes",
        "budgets"
      ],
      "additionalProperties": false
    }
  }
}
