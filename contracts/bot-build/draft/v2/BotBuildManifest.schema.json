{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/bot-build/draft/v2/BotBuildManifest.schema.json",
  "title": "BotBuildManifestDraftV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {"const": "bot-build-manifest/v2"},
    "playbook_id": {"type": "string", "minLength": 1},
    "bot_id": {"type": "string", "pattern": "^bot-[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}
      },
      "required": ["source_id", "source_revision"]
    },
    "playbook_version": {"const": "capture-playbook-draft/v2"},
    "playbook_sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "ir_version": {"const": "collector-ir/v1"},
    "ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend_id": {"type": "string", "minLength": 1},
    "backend_version": {"type": "string", "minLength": 1},
    "capability_profile_id": {"type": "string", "minLength": 1},
    "capability_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_version": {"type": "string", "minLength": 1},
    "runtime_identity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "package": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "version": {"type": "string", "minLength": 1},
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["package", "version", "files", "sha256"]
    },
    "dependency_identity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packages": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "required": ["lockfile_sha256", "packages"]
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "worker_contract": {"type": "string", "minLength": 1},
        "execution_mode": {"enum": ["fixture-only", "live-authorized"]},
        "runtime_profile": {"type": "string", "minLength": 1},
        "python_minor": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "target_platform": {"type": "string", "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"},
        "scrapy": {"type": "string"},
        "scrapy_runtime": {"type": "string"}
      },
      "required": ["worker_contract", "execution_mode", "python_minor", "target_platform"]
    },
    "toolchain": {"type": "object", "minProperties": 1},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "input_fixtures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": true,
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "evidence_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "content_type": {"type": "string", "minLength": 1},
          "status": {"type": "integer", "minimum": 100, "maximum": 599},
          "source_id": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1}
        },
        "required": ["url", "evidence_ref", "sha256", "size_bytes", "content_type", "status", "source_id", "source_revision"]
      }
    },
    "live_request": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "method": {"const": "GET"},
        "url": {"type": "string", "format": "uri"}
      },
      "required": ["method", "url"]
    },
    "build_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["manifest_version", "playbook_id", "bot_id", "source", "playbook_version", "playbook_sha256", "ir_version", "ir_sha256", "backend_id", "backend_version", "capability_profile_id", "capability_profile_sha256", "compiler_version", "runtime_identity", "dependency_identity", "compatibility", "toolchain", "dependency_lock_sha256", "generated_files", "input_fixtures", "build_id"],
  "allOf": [
    {
      "if": {"properties": {"compatibility": {"properties": {"execution_mode": {"const": "fixture-only"}}}}},
      "then": {
        "properties": {"input_fixtures": {"minItems": 1}, "compatibility": {"not": {"required": ["runtime_profile"]}}},
        "not": {"required": ["live_request"]}
      }
    },
    {
      "if": {"properties": {"compatibility": {"properties": {"execution_mode": {"const": "live-authorized"}}}}},
      "then": {
        "properties": {"input_fixtures": {"maxItems": 0}, "compatibility": {"required": ["runtime_profile"]}},
        "required": ["live_request"]
      }
    }
  ]
}
