{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/examples/controlled-work-intake-record/v1",
  "title": "Controlled live JSON record",
  "description": "Output contract for the isolated controlled live acquisition acceptance source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "quantity", "unit_price", "enabled", "_provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "quantity": {"type": "integer", "minimum": 0},
    "unit_price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "enabled": {"type": "boolean"},
    "_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_revision", "requested_url", "effective_url", "source_url", "evidence_ref", "raw_sha256", "operation_id", "page_index", "record_index"],
      "properties": {
        "source_id": {"const": "controlled-http"},
        "source_revision": {"const": "controlled-work-intake-v1"},
        "requested_url": {"type": "string", "format": "uri"},
        "effective_url": {"type": "string", "format": "uri"},
        "source_url": {"type": "string", "format": "uri"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operation_id": {"type": "string", "minLength": 1},
        "page_index": {"type": "integer", "minimum": 0},
        "record_index": {"type": "integer", "minimum": 0}
      }
    }
  }
}
