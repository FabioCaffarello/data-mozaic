{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/artifact-custody/draft/v1/ArtifactMetadata.schema.json",
  "title": "BC06 Artifact Metadata",
  "description": "Logical metadata view. Physical object locations are private infrastructure state.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "artifact-custody.v1"},
    "artifact": {"$ref": "CustodyReceipt.schema.json#/properties/artifact"},
    "source": {"$ref": "CustodyReceipt.schema.json#/properties/source"},
    "representation": {"$ref": "CustodyReceipt.schema.json#/properties/representation"},
    "classification": {"$ref": "CustodyReceipt.schema.json#/properties/classification"},
    "retention_policy_ref": {"$ref": "CustodyReceipt.schema.json#/properties/retention_policy_ref"},
    "state": {"enum": ["pending_upload", "uploading", "available", "unavailable", "inconsistent"]},
    "created_at": {"type": "string", "format": "date-time"},
    "confirmed_at": {"type": "string", "format": "date-time"}
  },
  "required": ["contract_version", "artifact", "source", "representation", "classification", "retention_policy_ref", "state", "created_at"]
}
