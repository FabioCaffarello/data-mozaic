# Reference only: replace every placeholder and export these values from the
# protected operator shell. Do not source this template or commit populated
# secrets. Load the existing BC04, BC13, MongoDB, and BC06 owner configuration
# separately using the repository's local environment files.

# Owner connectivity and credentials (secret values come from existing local
# owner configuration):
BC04_DATABASE_URL=<BC04 PostgreSQL DSN>
WORK_INTAKE_DATABASE_URL=<BC13 PostgreSQL DSN>
BC04_GRANT_SIGNING_KEY=<32-byte Ed25519 seed encoded as 64 hex characters>
BC04_GRANT_KEY_ID=<configured BC04 publication grant key ID>
ARTIFACT_CUSTODY_HTTP_URL=http://127.0.0.1:8086
ARTIFACT_CUSTODY_LOCAL_TOKEN=<BC06 local authenticated API token>
GATEWAY_HTTP_URL=http://127.0.0.1:8090
GATEWAY_EVIDENCE_IMPORT_TOKEN=<Gateway evidence import credential>

# Approved authority and protected runtime configuration:
MOZAIC_OPERATOR_ID=<operator dispatcher label>
MOZAIC_AUTHORITY_ID=<BC04 authority ID>
MOZAIC_AUTHORITY_TRUSTED_PUBLIC_KEY_FILE=<path to trusted public key, 32 raw bytes>
MOZAIC_EXECUTION_CAPABILITY_SIGNING_KEY_FILE=<owner-only file, 32 raw bytes>
MOZAIC_EXECUTION_CAPABILITY_KEY_ID=<Gateway trusted BC04 capability key ID>
MOZAIC_LIVE_COMPOSE_PROJECT=<fixed lowercase Compose project name>
MOZAIC_LIVE_TRUSTED_CONFIG=<directory mounted read-only by the Gateway>
MOZAIC_LIVE_PLAYBOOK=examples/use-cases/controlled-work-intake/capture-playbook.yaml
MOZAIC_LIVE_FIXTURES=examples/use-cases/controlled-work-intake/fixtures
MOZAIC_PAYLOAD_CONTRACT_ROOT=contracts/payload/draft/v1

# Optional lifecycle database DSN; defaults to BC04_DATABASE_URL:
# LIFECYCLE_DATABASE_URL=<lifecycle owner PostgreSQL DSN>
