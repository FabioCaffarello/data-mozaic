FROM golang:1.27.4-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/controlled-source ./cmd/controlled-source

FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/controlled-source /controlled-source
USER nonroot:nonroot
EXPOSE 443 8080
ENTRYPOINT ["/controlled-source"]
