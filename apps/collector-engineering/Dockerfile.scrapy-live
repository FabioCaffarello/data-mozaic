FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS build
COPY --from=ghcr.io/astral-sh/uv:0.9.8@sha256:08f409e1d53e77dfb5b65c788491f8ca70fe1d2d459f41c89afa2fcbef998abe /uv /uvx /bin/
WORKDIR /workspace
COPY . /workspace
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
RUN uv sync --locked --no-dev --no-editable --package mozaic-collector-engineering
ARG MOZAIC_LIVE_PLAYBOOK=examples/use-cases/controlled-live-json/capture-playbook.yaml
ARG MOZAIC_LIVE_FIXTURES=examples/use-cases/controlled-live-json/fixtures
RUN uv run --locked --package mozaic-collector-engineering python -m collector_engineering compile "$MOZAIC_LIVE_PLAYBOOK" --backend scrapy-live-http --fixtures "$MOZAIC_LIVE_FIXTURES" --output /opt/live-bot --target-platform linux/amd64

FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /workspace
COPY --from=build /opt/venv /opt/venv
COPY --from=build --chown=65532:65532 /opt/live-bot /opt/live-bot
COPY tooling/scrapy_live_gateway_smoke.py /workspace/tooling/scrapy_live_gateway_smoke.py
USER 65532:65532
ENTRYPOINT ["python", "-B", "/workspace/tooling/scrapy_live_gateway_smoke.py"]
