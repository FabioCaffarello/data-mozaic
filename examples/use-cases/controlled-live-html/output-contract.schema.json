{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-mozaic.example/contracts/examples/controlled-live-html-record/v1",
  "title": "Controlled test HTML record",
  "description": "Payload contract for the isolated controlled HTTP test source only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "price", "_provenance"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "price": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "_provenance": {"type": "object"}
  }
}
