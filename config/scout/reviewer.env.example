# Template only. Install as /etc/data-mozaic/scout/reviewer.env, owned by
# root:scout-reviewer, mode 0640. Use a reviewer-scoped database credential.
SCOUT_DATABASE_URL=postgresql://REPLACE_WITH_REVIEWER_USER:REDACTED@db.example.invalid:5432/data_mozaic
SCOUT_REVIEW_SOURCE_REGISTRY=/etc/data-mozaic/scout/authoring-policy.json
SCOUT_EVIDENCE_ROOT=/var/lib/data-mozaic/scout-evidence
LIFECYCLE_DATABASE_URL=postgresql://REPLACE_WITH_PLAYBOOK_REGISTRATION_USER:REDACTED@db.example.invalid:5432/data_mozaic
MOZAIC_PAYLOAD_CONTRACT_ROOT=/opt/data-mozaic/scout-broker/current/contracts/payload/draft/v1
