# Template only. Install as /etc/data-mozaic/scout/broker.env with root:root
# ownership and mode 0600. Replace credentials through the protected secret
# channel; never commit a populated environment file.
SCOUT_TRUSTED_HTTP=1
SCOUT_LOCAL_PRINCIPAL=scout-local-acceptance
SCOUT_DATABASE_URL=postgresql://REPLACE_WITH_SCOPED_USER:REDACTED@db.example.invalid:5432/data_mozaic
SCOUT_HOST_POLICY_FILE=/etc/data-mozaic/scout/authoring-policy.json
SCOUT_RUNTIME_STATE_DIR=/var/lib/data-mozaic/scout
SCOUT_EVIDENCE_ROOT=/var/lib/data-mozaic/scout-evidence
SCOUT_EVIDENCE_REVIEWER_GID=REPLACE_WITH_SCOUT_EVIDENCE_REVIEWERS_GID
SCOUT_ARTIFACT_ROOT=/var/lib/data-mozaic/scout-artifacts
HOME=/var/lib/data-mozaic/scout
DOCKER_CONFIG=/etc/data-mozaic/scout/docker-config
SCOUT_BC15_WORKER_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
SCOUT_DOCKER_EXECUTABLE=/usr/bin/docker
SCOUT_DOCKER_CONTEXT=default
SCOUT_DOCKER_ENDPOINT=unix:///var/run/docker.sock
SCOUT_EGRESS_PROXY=http://127.0.0.1:3128
SCOUT_BROKER_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
