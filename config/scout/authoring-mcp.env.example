# Copy to .local/scout-mcp.env and replace local-only values.
# This local principal is an identifier, not a credential or an authorization grant.
SCOUT_LOCAL_PRINCIPAL=replace-with-local-analyst-id
SCOUT_HOST_POLICY_FILE=.local/authoring-policy.json
SCOUT_EVIDENCE_ROOT=/absolute/path/outside/the/repository/scout-evidence
SCOUT_ARTIFACT_ROOT=/absolute/path/outside/the/repository/scout-artifacts
SCOUT_EGRESS_PROXY=http://127.0.0.1:3128
